---
import '~/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '~/data/site';
import TitleBar from '~/components/TitleBar.astro';
import Taskbar from '~/components/Taskbar.astro';
import Desktop from '~/components/Desktop.tsx';
import DesktopShortcut from '~/components/DesktopShortcut.tsx';
import { desktopRows, desktopShortcuts, isCurrent, secondaryNav } from '~/lib/navigation';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const windowTitle = `${canonical.host}${currentPath === '/' ? '' : currentPath}`;
---

{/*
  transition:animate="none" turns off Astro's page-wide default fade to avoid flickering.
  Elements that should animate opt in explicitly.
*/}
<html lang="en-GB" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />

    <script is:inline>
      // Must be inline and in <head> to run before first paint.
      (() => {
        function applyTheme() {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle(
            'dark',
            stored === 'dark' || (!stored && prefersDark),
          );
        }

        applyTheme();

        if (!window.themeSwapBound) {
          // The router swaps the root element's attributes, which drops the class.
          // after-swap is the last moment before the new page paints.
          window.themeSwapBound = true;
          document.addEventListener('astro:after-swap', applyTheme);
        }
      })();
    </script>
  </head>

  <body class="desktop-ground flex min-h-screen flex-col font-sans antialiased">
    <a
      href="#start-menu"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-30 focus:border focus:border-border focus:bg-surface focus:px-3 focus:py-2"
    >
      Skip to navigation
    </a>
    {/* The desktop outlives whatever document is open, so it is kept rather than
        rebuilt — which also keeps the press handlers bound to it. The wrapper
        exists because transition directives apply to elements, not component
        tags; it is layout-neutral because the shortcuts are fixed or hidden. */}
    <div transition:persist="desktop-top">
      <Desktop rows={desktopRows(desktopShortcuts)}>
        {desktopShortcuts.map((item) => (
          <DesktopShortcut
            icon={item.icon}
            label={item.label}
            href={item.href}
            external={item.external}
            selected={isCurrent(item, currentPath)}
          />
        ))}
      </Desktop>
    </div>

    <div transition:persist="desktop-bottom">
      <Desktop anchor="bottom" rows={desktopRows(secondaryNav)} label="More desktop shortcuts">
        {secondaryNav.map((item) => (
          <DesktopShortcut
            icon={item.icon}
            label={item.label}
            href={item.href}
            external={item.external}
            selected={isCurrent(item, currentPath)}
          />
        ))}
      </Desktop>
    </div>

    {/* Spans the viewport to centre the window, so it would otherwise sit over the desktop shortcuts and swallow their clicks. */}
    <div class="pointer-events-none relative z-10 flex flex-1 flex-col lg:px-10 lg:py-12 lg:pb-24">
      {/* Named rather than persisted: the frame should read as one window
          showing new content, and it must arrive un-minimised. */}
      <div
        transition:name="window"
        data-window-frame
        class="window-frame pointer-events-auto mx-auto flex w-full max-w-4xl flex-1 flex-col lg:flex-none"
      >
        <TitleBar title={windowTitle} icon="document" minimisable />

        <main id="main" transition:animate="fade" class="flex-1 px-4 py-8 sm:px-6">
          <slot />
        </main>
      </div>
    </div>

    <Taskbar currentPath={currentPath} windowTitle={windowTitle} />

    <script>
      import { enableDesktopChrome } from '~/lib/desktop-chrome';
      enableDesktopChrome();
    </script>
  </body>
</html>
