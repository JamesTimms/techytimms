---
import '~/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { site } from '~/data/site';
import Dock from '~/components/Dock.astro';
import StatusBar from '~/components/StatusBar.astro';
import WindowFrame from '~/components/WindowFrame.astro';
import { Wallpaper } from '~/components/ui/Wallpaper';
import { DesktopSection, DesktopShortcut } from '~/components/ui/Desktop.tsx';
import { primaryShortcuts, secondaryShortcuts, desktopRows, isCurrent } from '~/lib/navigation';
import { type BarPosition } from '~/components/ui/Bar.tsx';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

const windowTitle = `${canonical.host}${currentPath === '/' ? '' : currentPath}`;

const dockPosition: BarPosition = 'bottom';
const statusPosition: BarPosition = 'top';
---

{/*
  transition:animate="none" turns off Astro's page-wide default fade to avoid flickering.
  Elements that should animate opt in explicitly.
*/}
<html lang="en-GB" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={site.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href="/sitemap-index.xml" />

    <ClientRouter />

    <Wallpaper />

    <script is:inline>
      // Must be inline and in <head> to run before first paint.
      (() => {
        function applyTheme() {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle(
            'dark',
            stored === 'dark' || (!stored && prefersDark),
          );
        }

        // Desktop only (matches window-interact.ts's lg gate) — mirrors its
        // `applyRect`, but unclamped: the bars aren't in the DOM yet here, so
        // bar-aware clamping stays on `astro:page-load`, which re-clamps and
        // rewrites both this and sessionStorage once they exist.
        function applyWindowRect() {
          const html = document.documentElement;
          if (!window.matchMedia('(min-width: 64rem)').matches) return;
          let rect = null;
          try {
            rect = JSON.parse(sessionStorage.getItem('window-rect'));
          } catch {}
          if (
            !rect ||
            typeof rect.left !== 'number' ||
            typeof rect.top !== 'number' ||
            typeof rect.width !== 'number' ||
            typeof rect.height !== 'number'
          ) {
            return;
          }
          html.dataset.positioned = 'true';
          html.style.setProperty('--window-left', `${rect.left}px`);
          html.style.setProperty('--window-top', `${rect.top}px`);
          html.style.setProperty('--window-width', `${rect.width}px`);
          html.style.setProperty('--window-height', `${rect.height}px`);
        }

        applyTheme();
        applyWindowRect();

        if (!window.preRenderSwapBound) {
          // The router swaps the root element's attributes, which drops both
          // the theme class and the window-rect flag/properties above.
          // after-swap is the last moment before the new page paints.
          window.preRenderSwapBound = true;
          document.addEventListener('astro:after-swap', () => {
            applyTheme();
            applyWindowRect();
          });
        }
      })();
    </script>
  </head>

  <body class="desktop-ground flex min-h-dvh flex-col font-sans antialiased">
    <a
      href="#dock-nav"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-30 focus:border focus:border-border focus:bg-surface focus:px-3 focus:py-2"
    >
      Skip to navigation
    </a>
    <StatusBar currentPath={currentPath} position={statusPosition} />

    {primaryShortcuts.length > 0 && (
      <div transition:persist="persist-desktop-top">
        <DesktopSection rows={desktopRows(primaryShortcuts)}>
          {primaryShortcuts.map((item) => (
            <DesktopShortcut
              icon={item.icon}
              label={item.label}
              href={item.href}
              external={item.external}
              selected={isCurrent(item, currentPath)}
            />
          ))}
        </DesktopSection>
      </div>
    )}

    {secondaryShortcuts.length > 0 && (
      <div transition:persist="persist-desktop-bottom">
        <DesktopSection
          anchor="bottom"
          rows={desktopRows(secondaryShortcuts)}
          label="More desktop shortcuts"
        >
          {secondaryShortcuts.map((item) => (
            <DesktopShortcut
              icon={item.icon}
              label={item.label}
              href={item.href}
              external={item.external}
              selected={isCurrent(item, currentPath)}
            />
          ))}
        </DesktopSection>
      </div>
    )}

    <WindowFrame title={windowTitle} palette="pumpkin">
      <slot />
    </WindowFrame>

    <Dock
      currentPath={currentPath}
      windowTitle={windowTitle}
      position={dockPosition}
      sticky
    />

    <script>
      import { enableDesktop } from '~/lib/desktop';
      import { enableClock } from '~/lib/clock';
      import { enableWindowInteract } from '~/lib/window';
      enableDesktop();
      enableClock();
      enableWindowInteract();
    </script>
  </body>
</html>
