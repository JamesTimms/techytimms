---
import BaseLayout from '~/layouts/BaseLayout.astro';
import GroupBox from '~/components/GroupBox.astro';
import Panel from '~/components/Panel.astro';
import { site } from '~/data/site';
import { getCollection } from 'astro:content';
import { excludeDrafts, newestFirst, featuredFirst, formatDate } from '~/lib/content';
import { linkClass } from '~/lib/link-accent';

const posts = newestFirst(excludeDrafts(await getCollection('posts'))).slice(0, 3);
const projects = featuredFirst(excludeDrafts(await getCollection('work'))).slice(0, 3);
---

<BaseLayout>
  <section>
    <h1 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{site.tagline}</h1>
    <p class="mt-4 max-w-prose text-ink-muted">
      Former technical lead at EatPing, previously CTO and co-founder at Mappa. I work across the
      stack and enjoy building meaningful products for real people.
    </p>
  </section>

  <GroupBox label="recent-writing" class="mt-10">
    {posts.length === 0 ? (
      <Panel tone="sunk" class="px-4 py-6 text-sm text-ink-muted">
        Nothing published yet.
      </Panel>
    ) : (
      <ul class="flex flex-col gap-5">
        {posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class:list={[linkClass(`/blog/${post.id}`), 'font-medium']}
            >
              {post.data.title}
            </a>
            <p class="mt-1 text-sm text-ink-muted">{post.data.summary}</p>
            <p class="font-mono text-xs uppercase tracking-widest text-ink-faint">
              {formatDate(post.data.publishedAt)}
            </p>
          </li>
        ))}
      </ul>
    )}
  </GroupBox>

  <GroupBox label="selected-work">
    <ul class="flex flex-col gap-5">
      {projects.map((project) => (
        <li>
          <a
            href={`/work/${project.id}`}
            class:list={[linkClass(`/work/${project.id}`), 'font-medium']}
          >
            {project.data.title}
          </a>
          <p class="mt-1 text-sm text-ink-muted">{project.data.outcome}</p>
        </li>
      ))}
    </ul>
  </GroupBox>
</BaseLayout>
