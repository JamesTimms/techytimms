---
import globalCss from '~/styles/global.css?raw';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { mainHues, tokenPairings, type MainHueKey } from '~/data/color-system';
import { oklchToHex, parseThemedColorTokens, requireToken, type Oklch } from '~/lib/color-tokens';
import { maxChromaInGamut, nearestRampStep, RAMP_LIGHTNESS_STEPS } from '~/lib/hue-ramp';
import { huetonePaletteUrl, oklchPaletteUrl } from '~/lib/huetone';
import { ResetColourTweaks } from '~/components/ui/ColourControl';
import { TokenPairings } from '~/components/ui/TokenPairings';
import { Wallpaper } from '~/components/ui/Wallpaper';

/*
 * A development surface for the colour system, not site content: `noindex`
 * here, and excluded from the sitemap in `astro.config.mjs`. Everything below
 * is parsed from `global.css` at build time (via Vite's `?raw` import).
 */

const { light: lightTokens, dark: darkTokens } = parseThemedColorTokens(globalCss);

const isLinkToken = (name: string) => name.startsWith('link-');
const isRampToken = (name: string) => name.startsWith('leaf-') || name.startsWith('pumpkin-');

// ---------------------------------------------------------------------------
// 2. Every colour used by any token
// ---------------------------------------------------------------------------

interface FamilyEntry {
  name: string;
  theme: 'light' | 'dark' | 'both';
  oklch: Oklch;
  hex: string;
}

function themeVariants(name: string): FamilyEntry[] {
  const light = lightTokens[name];
  const dark = darkTokens[name];
  if (!light) return [];
  const identical =
    dark && light.oklch.l === dark.oklch.l && light.oklch.c === dark.oklch.c && light.oklch.h === dark.oklch.h;
  if (identical) return [{ name, theme: 'both', oklch: light.oklch, hex: light.hex }];
  const entries: FamilyEntry[] = [{ name, theme: 'light', oklch: light.oklch, hex: light.hex }];
  if (dark) entries.push({ name, theme: 'dark', oklch: dark.oklch, hex: dark.hex });
  return entries;
}

const semanticEntries: FamilyEntry[] = Object.keys(lightTokens)
  .filter((name) => !isLinkToken(name) && !isRampToken(name))
  .flatMap(themeVariants);

const NEUTRAL_CHROMA = 0.04;
const ONE_JND = 0.02;

const signedHueDelta = (a: number, b: number) => ((a - b + 540) % 360) - 180;

function familyOf({ c, h }: Oklch): MainHueKey {
  if (c < NEUTRAL_CHROMA) return 'neutral';
  if (Math.abs(signedHueDelta(h, 80)) <= 2) return 'leaf';
  if (Math.abs(signedHueDelta(h, 55)) <= 2) return 'pumpkin';
  return 'accent';
}

function median(values: number[]): number {
  const sorted = [...values].sort((a, b) => a - b);
  const middle = Math.floor(sorted.length / 2);
  return sorted.length % 2 ? sorted[middle]! : (sorted[middle - 1]! + sorted[middle]!) / 2;
}

function definedRamp(name: string): Oklch[] {
  return RAMP_LIGHTNESS_STEPS.map(({ step }) => requireToken(lightTokens, `${name}-${step}`).oklch);
}

function sharedLightnessRamp(members: FamilyEntry[]): Oklch[] {
  const h = Math.round(median(members.map((member) => member.oklch.h)));
  const c = Number(median(members.map((member) => member.oklch.c)).toFixed(3));
  return RAMP_LIGHTNESS_STEPS.map(({ lightnessPercent }) => ({ l: lightnessPercent / 100, c, h }));
}

const signed = (value: number, digits: number) => `${value < 0 ? '−' : '+'}${Math.abs(value).toFixed(digits)}`;
const formatLch = ({ l, c, h }: Oklch) => `L${Number((l * 100).toFixed(1))} C${c.toFixed(3)} H${Math.round(h)}`;
const cssOklch = ({ l, c, h }: Oklch) => `oklch(${Number((l * 100).toFixed(1))}% ${c.toFixed(3)} ${Math.round(h)})`;
const themeLabel = (entry: FamilyEntry) => (entry.theme === 'both' ? entry.name : `${entry.name} (${entry.theme})`);

function deviationExplanation(entry: FamilyEntry, reference: Oklch, deltaL: number, deltaC: number, deltaH: number): string {
  const sentences: string[] = [];
  if (Math.abs(deltaL) >= 0.5) {
    sentences.push(`It is ${Math.abs(deltaL).toFixed(1)} points ${deltaL < 0 ? 'darker' : 'lighter'} than the step.`);
  }
  if (Math.abs(deltaC) >= 0.005) {
    sentences.push(`It carries ${Math.abs(deltaC).toFixed(3)} ${deltaC < 0 ? 'less' : 'more'} chroma than the step.`);
  }
  let chromaHeadroomGained = false;
  if (Math.abs(deltaH) >= 1 && entry.oklch.c >= NEUTRAL_CHROMA) {
    const capAtOwnHue = maxChromaInGamut(entry.oklch.l, entry.oklch.h);
    const capAtReferenceHue = maxChromaInGamut(entry.oklch.l, reference.h);
    chromaHeadroomGained = capAtOwnHue > capAtReferenceHue;
    sentences.push(
      `At L ${(entry.oklch.l * 100).toFixed(1)}%, hue ${Math.round(entry.oklch.h)} allows ${capAtOwnHue.toFixed(3)} chroma, against ${capAtReferenceHue.toFixed(3)} at hue ${Math.round(reference.h)}.`,
    );
  }
  sentences.push('The reason for the deviation is not recorded.');
  if (chromaHeadroomGained) sentences.push('Guess: the hue shift buys chroma headroom, so the colour stays vivid instead of turning brown.');
  else if (Math.abs(deltaL) >= 2) sentences.push('Guess: the lightness was moved to meet the contrast target of a pairing in §4.');
  return sentences.join(' ');
}

const familyCaptions: Record<MainHueKey, string> = {
  pumpkin: 'Defined ramp in global.css.',
  leaf: 'Defined ramp in global.css. Used only by the unused `fallen-leaf` window variant.',
  neutral: 'Tokens with chroma < 0.04. Reference: shared lightness scale at the median token hue and chroma.',
  accent: 'Remaining tokens. Reference: shared lightness scale at the median token hue and chroma.',
};

const familyRows = mainHues.map((family) => {
  const members = semanticEntries.filter((entry) => familyOf(entry.oklch) === family.key);
  const referenceRamp = family.liveRamp ? definedRamp(family.liveRamp) : sharedLightnessRamp(members);

  const steps = RAMP_LIGHTNESS_STEPS.map(({ step }, index) => {
    const reference = referenceRamp[index]!;
    const clean: FamilyEntry[] = [];
    const deviations: (FamilyEntry & { delta: string; info: string })[] = [];

    for (const entry of members) {
      if (nearestRampStep(entry.oklch.l * 100).step !== step) continue;
      const deltaL = (entry.oklch.l - reference.l) * 100;
      const deltaC = entry.oklch.c - reference.c;
      const deltaH = signedHueDelta(entry.oklch.h, reference.h);
      const hueDistance = 2 * Math.sqrt(entry.oklch.c * reference.c) * Math.sin((deltaH * Math.PI) / 360);
      const distance = Math.hypot(deltaL / 100, deltaC, hueDistance);
      if (distance < ONE_JND) {
        clean.push(entry);
        continue;
      }
      deviations.push({
        ...entry,
        delta: `Δ L ${signed(deltaL, 1)} · C ${signed(deltaC, 3)} · H ${signed(deltaH, 0)}°`,
        info: `${themeLabel(entry)}\n${cssOklch(entry.oklch)}\n${entry.hex}\n\n${deviationExplanation(entry, reference, deltaL, deltaC, deltaH)}`,
      });
    }

    return { step, reference, referenceHex: oklchToHex(reference), clean, deviations, unused: !clean.length && !deviations.length };
  });

  return {
    key: family.key,
    name: family.name,
    caption: familyCaptions[family.key],
    steps,
    huetoneUrl: huetonePaletteUrl(family.name, [{ name: family.name, colors: steps.map((s) => s.referenceHex) }]),
    oklchPaletteHref: oklchPaletteUrl(steps.find((s) => s.step === 500)!.reference),
  };
});

const combinedHuetoneUrl = huetonePaletteUrl(
  'techytimms',
  familyRows.map((row) => ({ name: row.name, colors: row.steps.map((s) => s.referenceHex) })),
);

function copyAttrs(oklch: Oklch, hex: string, info?: string) {
  const text = cssOklch(oklch);
  return { 'data-copy-oklch': text, 'data-swatch-info': info ?? `${text}\n${hex}` };
}

// ---------------------------------------------------------------------------
// 3. Tokens in use
// ---------------------------------------------------------------------------

const pairedTokens = new Set(tokenPairings.flatMap((row) => [row.background, ...row.foregrounds.map((pairing) => pairing.token)]));
const otherTokens = Object.keys(lightTokens).filter(
  (name) => !isLinkToken(name) && !isRampToken(name) && !pairedTokens.has(name),
);

const tokenValues = Object.fromEntries(
  [...pairedTokens, ...otherTokens].map((name) => [
    name,
    { light: requireToken(lightTokens, name).oklch, dark: requireToken(darkTokens, name).oklch },
  ]),
);

const lightThemeCss = `.theme-light{${Object.entries(lightTokens)
  .map(([name, token]) => `--color-${name}:oklch(${token.oklchText})`)
  .join(';')}}`;
---

<BaseLayout title="Styleguide" description="The colour system." noindex>
  <h1 class="text-2xl font-semibold tracking-tight">Colour system</h1>
  <p class="mt-3 max-w-prose text-ink-muted">
    Figures are parsed from <code class="text-ink">global.css</code> at build time. Hover a
    swatch for details; click to copy. Click a token chip in §3 to tweak it live on this page
    only — nothing is saved.
  </p>

  {/* ===================================================================
      1. Goals and dials
      =================================================================== */}
  <section class="mt-10">
    <h2 class="text-xl font-semibold tracking-tight">1. Goals and dials</h2>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full min-w-[32rem] border-collapse text-sm">
        <tbody>
          <tr class="border-t border-rule">
            <td class="py-2 pr-4 font-medium text-ink-muted">Priority</td>
            <td class="py-2 text-ink">Contrast first — the APCA pair fixes lightness before chroma or hue move.</td>
          </tr>
          <tr class="border-t border-rule">
            <td class="py-2 pr-4 font-medium text-ink-muted">Order</td>
            <td class="py-2 text-ink">L → C → H, always in that order.</td>
          </tr>
          <tr class="border-t border-rule">
            <td class="py-2 pr-4 font-medium text-ink-muted">1 JND</td>
            <td class="py-2 text-ink">0.02 in OKLCH — CSS Color 4's own gamut-mapping threshold.</td>
          </tr>
          <tr class="border-t border-rule">
            <td class="py-2 pr-4 font-medium text-ink-muted">Chroma</td>
            <td class="py-2 text-ink">Capped by the gamut; peaks at each hue's own cusp lightness, not at a fixed L.</td>
          </tr>
          <tr class="border-t border-rule">
            <td class="py-2 pr-4 font-medium text-ink-muted">Hue</td>
            <td class="py-2 text-ink">Only visible in proportion to chroma — hue drift at low chroma is inert.</td>
          </tr>
          <tr class="border-t border-rule">
            <td class="py-2 pr-4 font-medium text-ink-muted">Hue drift</td>
            <td class="py-2 text-ink">Stays inside the colour family it started in.</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  {/* ===================================================================
      2. Every colour used by any token
      =================================================================== */}
  <section class="mt-14 border-t border-rule pt-8">
    <h2 class="text-xl font-semibold tracking-tight">2. Every colour used by any token</h2>
    <p class="mt-2 max-w-prose text-sm text-ink-muted">
      One row per family. Top swatch: reference step. Tokens within a JND are listed under it;
      the rest get their own swatch — hover for why.
      <a href={combinedHuetoneUrl} class="link link-3 ml-1">All families in huetone →</a>
    </p>

    <div class="mt-6 flex flex-col gap-10">
      {
        familyRows.map((row) => (
          <div>
            <h3 class="flex flex-wrap items-baseline gap-x-2 text-sm font-semibold">
              <span class="uppercase tracking-wide text-ink-faint">{row.name}</span>
              <span class="ml-auto flex gap-3 text-xs font-normal normal-case tracking-normal">
                <a href={row.huetoneUrl} class="link link-3">huetone →</a>
                <a href={row.oklchPaletteHref} class="link link-3">oklch-palette (500) →</a>
              </span>
            </h3>
            <p class="mt-1 max-w-prose text-xs text-ink-faint">{row.caption}</p>

            <div class="mt-2 flex flex-wrap gap-2">
              {row.steps.map((step) => (
                <div class:list={['w-36 shrink-0 border p-1 text-center', step.unused ? 'border-dashed border-rule' : 'border-rule']}>
                  <div class:list={[step.unused && '[&>div]:opacity-50']}>
                    <button
                      type="button"
                      class="copy-swatch relative block h-9 w-full border border-border"
                      style={`background-color:${step.referenceHex}`}
                      aria-label={`Copy step ${step.step} oklch value`}
                      {...copyAttrs(step.reference, step.referenceHex)}
                    >
                      <span class="copy-feedback pointer-events-none absolute inset-0 flex items-center justify-center bg-surface text-[0.55rem] font-semibold text-ink opacity-0">
                        Copied
                      </span>
                    </button>
                    <div class="mt-1 font-mono text-[0.6rem] text-ink-faint">{step.step}</div>
                    <div class="font-mono text-[0.55rem] text-ink-faint">{formatLch(step.reference)}</div>
                  </div>
                  {step.unused && <div class="mt-0.5 text-[0.55rem] uppercase tracking-wide text-ink-faint">unused</div>}

                  {step.clean.length > 0 && (
                    <ul class="mt-0.5 flex flex-col gap-0.5">
                      {step.clean.map((entry) => (
                        <li class="truncate text-[0.58rem] leading-tight text-ink-muted" title={themeLabel(entry)}>
                          {themeLabel(entry)}
                        </li>
                      ))}
                    </ul>
                  )}

                  {step.deviations.map((entry) => (
                    <div class="mt-1 border border-accent bg-accent-sunk p-1 text-left">
                      <button
                        type="button"
                        class="copy-swatch relative block h-5 w-full border border-border"
                        style={`background-color:${entry.hex}`}
                        aria-label={`Copy ${entry.name} oklch value`}
                        {...copyAttrs(entry.oklch, entry.hex, entry.info)}
                      >
                        <span class="copy-feedback pointer-events-none absolute inset-0 flex items-center justify-center bg-surface text-[0.5rem] font-semibold text-ink opacity-0">
                          Copied
                        </span>
                      </button>
                      <div class="mt-0.5 truncate text-[0.58rem] font-semibold text-accent-ink" title={themeLabel(entry)}>
                        {themeLabel(entry)}
                      </div>
                      <div class="whitespace-nowrap text-[0.5rem] text-ink-muted">{entry.delta}</div>
                    </div>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* ===================================================================
      3. Tokens in use
      =================================================================== */}
  <section class="mt-14 border-t border-rule pt-8">
    <h2 class="text-xl font-semibold tracking-tight">3. Tokens in use</h2>
    <p class="mt-2 max-w-prose text-sm text-ink-muted">
      Light and dark side by side. Click a chip to edit; APCA follows live.
    </p>
    <div class="mt-3"><ResetColourTweaks client:load /></div>
    <style is:inline set:html={lightThemeCss} />
    <Wallpaper selector=".light-ground" darkSelector=".never-dark" />

    <div class="mt-4 grid gap-4 md:grid-cols-2">
      {
        (['light', 'dark'] as const).map((theme) => (
          <div class={theme === 'dark' ? 'dark' : 'theme-light'}>
            <div class="flex h-80 flex-col border border-border">
              <div class="flex items-center gap-2 border-b border-bar-edge bg-menu-bar px-2 py-1 text-xs text-ink-muted">
                <span class="text-accent">●</span>
                <span>James Timms</span>
                <span class="ml-auto">12:00</span>
              </div>
              <div class:list={[theme === 'dark' ? 'desktop-ground' : 'light-ground', 'relative flex-1 overflow-hidden']}>
                <div class="absolute left-3 top-3 flex w-16 flex-col items-center gap-1">
                  <span class="block h-8 w-8 border border-window-edge bg-surface" />
                  <span class="text-[0.65rem] text-desktop-ink">About</span>
                </div>
                <div class="absolute left-24 right-4 top-4 border border-window-edge bg-surface">
                  <div class="flex items-center justify-between bg-title-bar px-2 py-0.5 text-xs text-title-bar-ink">
                    <span>about.txt</span>
                    <span>×</span>
                  </div>
                  <div class="p-3 text-xs">
                    <p class="text-ink">Body text on the window face.</p>
                    <p class="mt-1 text-ink-muted">
                      Secondary text with <a href="#" class="text-accent-ink underline decoration-2 underline-offset-2">a link</a>.
                    </p>
                    <div class="mt-2 border border-border bg-sunk p-2 text-ink-faint">12 Sep 2026</div>
                  </div>
                </div>
              </div>
              <div class="flex items-center justify-center gap-4 border-t border-bar-edge bg-dock px-2 py-1 text-xs text-ink-muted">
                <span><span class="text-accent">●</span> Home</span>
                <span>Work</span>
                <span>Writing</span>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-6">
      <TokenPairings client:load values={tokenValues} rows={tokenPairings} otherTokens={otherTokens} />
    </div>
  </section>

  <script is:inline>
    // Click-to-copy for /styleguide's colour swatches: event delegation, one
    // listener for the whole page, so it survives however many swatches the
    // build produces. The only JavaScript this page ships.
    document.addEventListener('click', function (event) {
      var target = event.target;
      var swatch = target && target.closest ? target.closest('[data-copy-oklch]') : null;
      if (!swatch || !navigator.clipboard) return;
      navigator.clipboard.writeText(swatch.getAttribute('data-copy-oklch')).then(function () {
        swatch.setAttribute('data-copied', 'true');
        setTimeout(function () {
          swatch.removeAttribute('data-copied');
        }, 1200);
      });
    });
  </script>

  <style is:global>
    .copy-swatch {
      cursor: pointer;
    }
    [data-swatch-info]::after {
      content: attr(data-swatch-info);
      position: absolute;
      bottom: calc(100% + 4px);
      left: 50%;
      z-index: 30;
      transform: translateX(-50%);
      padding: 0.25rem 0.4rem;
      border: 1px solid var(--color-border);
      background-color: var(--color-surface);
      color: var(--color-ink);
      font-family: var(--font-mono, ui-monospace, monospace);
      font-size: 0.65rem;
      line-height: 1.3;
      text-align: left;
      width: max-content;
      max-width: 16rem;
      white-space: pre-line;
      pointer-events: none;
      opacity: 0;
    }
    [data-swatch-info]:hover::after,
    [data-swatch-info]:focus-visible::after {
      opacity: 1;
    }
    .copy-swatch[data-copied='true'] .copy-feedback {
      opacity: 1;
    }
  </style>
</BaseLayout>
