---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Window from "~/components/Window.astro";
import Panel from "~/components/Panel.astro";
import { getCollection } from "astro:content";
import { excludeDrafts, featuredFirst } from "~/lib/content";
import { linkClass } from "~/lib/link-accent";

const projects = featuredFirst(excludeDrafts(await getCollection("work")));
---

<BaseLayout title="Work" description="Projects and case studies by James Timms.">
  <h1 class="text-3xl font-semibold tracking-tight">Work</h1>

  <Window title="work" class="mt-8">
    {
      projects.length === 0 ? (
        <Panel tone="sunk" class="px-4 py-6 text-sm text-ink-muted">
          No write-ups published yet.
        </Panel>
      ) : (
        <ul class="flex flex-col gap-6">
          {projects.map((project) => (
            <li class="border-b border-rule pb-6 last:border-0 last:pb-0">
              <a
                href={`/work/${project.id}`}
                class:list={[linkClass(`/work/${project.id}`), "font-medium"]}
              >
                {project.data.title}
              </a>
              <p class="font-mono text-xs uppercase tracking-widest text-ink-faint">
                {project.data.role} · {project.data.period}
              </p>
              <p class="mt-2 text-sm text-ink-muted">{project.data.outcome}</p>
            </li>
          ))}
        </ul>
      )
    }
  </Window>
</BaseLayout>
