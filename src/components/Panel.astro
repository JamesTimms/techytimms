---
interface Props {
  tone?: "default" | "sunk" | "accent";
  class?: string;
}

const { tone = "default", class: className = "" } = Astro.props;

const toneClass = {
  default: "bg-surface",
  sunk: "bg-sunk",
  accent: "border-accent bg-accent-sunk",
}[tone];
---

<div class:list={["rounded-panel border border-border", toneClass, className]}>
  <slot />
</div>
