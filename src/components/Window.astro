---
import TitleBar from "~/components/TitleBar.astro";

/*
 * A panel with a 2000s title bar. Static markup by design: window management is
 * out of scope, so there is nothing to hydrate and a React island would ship a
 * renderer to deliver zero behaviour. The props below are the surface a React
 * version would take, so the swap is mechanical once windows can be moved.
 */
interface Props {
  title: string;
  tone?: "default" | "accent";
  controls?: boolean;
  class?: string;
}

const { title, tone = "default", controls = true, class: className = "" } = Astro.props;
---

<section class:list={["panel flex flex-col", className]}>
  <TitleBar title={title} tone={tone} controls={controls} />
  <div class="flex-1 px-4 py-5 sm:px-6">
    <slot />
  </div>
</section>
