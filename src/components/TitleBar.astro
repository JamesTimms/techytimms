---
import Icon from "~/components/Icon.astro";
import { type IconName } from "~/lib/icons";
import { cn } from "~/lib/cn";
import {
  glyphMinimise,
  glyphRestore,
  minimiseControl,
  titleBar,
  titleControl,
  type ChromeVariant,
} from "~/lib/window-variants";

interface Props {
  title: string;
  controls?: boolean;
  icon?: IconName;
  /* Only the window that owns the page can be put away; secondary windows keep
   * decorative controls until there is something for them to do. */
  minimisable?: boolean;
  chrome?: ChromeVariant;
}

const {
  title,
  controls = true,
  icon,
  minimisable = false,
  chrome = "period",
} = Astro.props;
---

<div class={titleBar({ chrome })}>
  <span class="flex min-w-0 items-center gap-2">
    {icon && <Icon name={icon} />}
    <span class="truncate text-xs font-semibold tracking-wide">
      {title}
    </span>
  </span>

  {
    /*
     * Maximise and close stay decorative: there is nothing to maximise to and
     * nowhere to close to, and a focusable control that does nothing announces
     * an action that never happens. The container must not be aria-hidden —
     * that would hide the real minimise button while leaving it focusable.
     */
    controls && (
      <span class="flex shrink-0 items-center gap-0.5">
        {minimisable ? (
          <button
            type="button"
            class={cn(
              titleControl({ chrome, pressable: true }),
              minimiseControl({ chrome }),
            )}
            data-window-minimise
            aria-label="Minimise window"
          >
            <span aria-hidden="true" class={glyphMinimise} />
          </button>
        ) : (
          <span
            aria-hidden="true"
            class={cn(titleControl({ chrome }), minimiseControl({ chrome }))}
          >
            <span class={glyphMinimise} />
          </span>
        )}
        <span aria-hidden="true" class={titleControl({ chrome })}>
          <span class={glyphRestore} />
        </span>
        <span aria-hidden="true" class={titleControl({ chrome })}>
          <span class="title-glyph-close" />
        </span>
      </span>
    )
  }
</div>
