---
import Icon from "~/components/Icon.astro";
import { type IconName } from "~/lib/icons";

interface Props {
  title: string;
  tone?: "default" | "accent";
  controls?: boolean;
  icon?: IconName;
}

const { title, tone = "default", controls = true, icon } = Astro.props;

const toneClass = tone === "accent" ? "bg-accent-sunk" : "bg-sunk";
---

<div
  class:list={[
    "flex items-center justify-between gap-3 border-b border-border px-2 py-1.5",
    toneClass,
  ]}
>
  <span class="flex min-w-0 items-center gap-2">
    {icon && <Icon name={icon} />}
    <span class="truncate font-mono text-xs uppercase tracking-widest text-ink">
      {title}
    </span>
  </span>

  {
    /*
     * Decorative until window management exists. Rendering these as <button>
     * would take a tab stop and announce an action that never happens.
     */
    controls && (
      <span aria-hidden="true" class="flex shrink-0 items-center gap-1">
        {["–", "□", "×"].map((glyph) => (
          <span class="title-control">{glyph}</span>
        ))}
      </span>
    )
  }
</div>
