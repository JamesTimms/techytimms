---
import Icon from "~/components/Icon.astro";
import {
  CloseButton,
  MaximiseButton,
  MinimiseButton,
  TitleBar,
  TitleBarLabel,
  TitleControls,
  type WindowPalette,
} from "~/components/ui/Window";
import { type IconName } from "~/lib/icons";

interface Props {
  title: string;
  controls?: boolean;
  icon?: IconName;
  minimisable?: boolean;
  maximisable?: boolean;
  closable?: boolean;
  palette?: WindowPalette;
  draggable?: boolean;
}

const {
  title,
  controls = true,
  icon,
  minimisable = false,
  maximisable = false,
  closable = false,
  palette = "fallen-leaf",
  draggable = false,
} = Astro.props;
---

<TitleBar palette={palette} draggable={draggable}>
  <TitleBarLabel draggable={draggable}>
    {icon && <Icon name={icon} />}
    <span class="truncate text-xs font-semibold tracking-wide" data-window-title>{title}</span>
  </TitleBarLabel>
  {
    controls && (
      <TitleControls>
        <MinimiseButton palette={palette} decorative={!minimisable} />
        <MaximiseButton palette={palette} decorative={!maximisable} />
        <CloseButton palette={palette} decorative={!closable} />
      </TitleControls>
    )
  }
</TitleBar>
