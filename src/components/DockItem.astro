---
import Icon from "~/components/Icon.astro";
import Tooltip from "~/components/Tooltip.astro";
import type { NavItem } from "~/lib/navigation";

/*
 * One destination in the dock: an icon, and nothing else visible.
 *
 * The words survive twice over — as the link's accessible name, and as the
 * tooltip on hover or focus — so nothing is carried by the picture alone.
 */
type Props = NavItem & { current: boolean };

const { href, label, icon, external = false, current } = Astro.props;
---

<a
  href={href}
  rel={external ? "me noopener" : undefined}
  target={external ? "_blank" : undefined}
  aria-current={current ? "page" : undefined}
  class="dock-item tooltip-anchor"
>
  <Icon name={icon} />
  <span class="sr-only">{label}{external && " (opens in a new tab)"}</span>
  <Tooltip label={label} />
</a>
