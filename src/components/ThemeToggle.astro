---
// The blocking script in BaseLayout applies the theme before first paint; the
// click handler is delegated from `desktop-chrome`, because this button is
// inside persisted chrome and binding per-instance would double up on it.
//
// Icons mirror SunDial's pixel art (src/components/Time.tsx) so the same body
// reads the same way everywhere on the site. Each icon shows the theme a
// click would switch *to* — sun in dark mode, moon in light mode — matching
// the "Light"/"Dark" text this replaces. The tooltip follows the same swap,
// so its wording always names the click's destination, not the current theme.
import Tooltip from "~/components/Tooltip.astro";
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle tooltip-anchor px-1.5 py-1.5"
  aria-label="Toggle colour theme"
>
  <svg
    class="theme-toggle-icon theme-toggle-sun hidden dark:block"
    viewBox="4 0 8 8"
    shape-rendering="crispEdges"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="7" y="2" width="2" height="1" />
    <rect x="6" y="3" width="4" height="2" />
    <rect x="7" y="5" width="2" height="1" />
    <rect x="7" y="0" width="2" height="1" />
    <rect x="7" y="7" width="2" height="1" />
    <rect x="4" y="3" width="1" height="2" />
    <rect x="11" y="3" width="1" height="2" />
  </svg>
  <svg
    class="theme-toggle-icon theme-toggle-moon block dark:hidden"
    viewBox="4 0 8 8"
    shape-rendering="crispEdges"
    aria-hidden="true"
    focusable="false"
  >
    <rect x="7" y="2" width="2" height="1" />
    <rect x="6" y="3" width="2" height="1" />
    <rect x="6" y="4" width="2" height="1" />
    <rect x="7" y="5" width="2" height="1" />
  </svg>
  <Tooltip label="Switch to light theme" class="hidden dark:block" />
  <Tooltip label="Switch to dark theme" class="block dark:hidden" />
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border-radius: 0.375rem;
    transition: background-color 0.15s ease-in-out;
  }

  .theme-toggle-icon {
    width: 2rem;
    height: 2rem;
  }

  /* Icons sit on taskbar fill (opposite theme), using inverted bar tokens.
     Same pairing as SunDial: bar-accent for the sun, bar-ink-muted for the moon. */
  .theme-toggle-sun {
    fill: var(--color-bar-accent);
    transition: fill 0.15s ease-in-out;
  }

  .theme-toggle-moon {
    fill: var(--color-bar-ink-muted);
    transition: fill 0.15s ease-in-out;
  }

  .theme-toggle {
    --toggle-hover-ink: var(--color-leaf-50);
  }

  :global(.dark) .theme-toggle {
    --toggle-hover-ink: var(--color-leaf-900);
  }

  .theme-toggle:hover,
  .theme-toggle:focus-visible,
  .theme-toggle:active {
    /* Blend surface with bar ink: light background for dark hover icon in light mode,
       accounts for theme in dark mode via theme-flipped tokens. */
    /* Hover drives the icon to the opposite end of the ramp from the bar fill,
       so contrast rises rather than falls; the background stays a light tint of
       that same colour, enough to read as a hover without eroding the gain. */
    background-color: color-mix(in oklab, var(--toggle-hover-ink) 12%, transparent);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--color-bar-accent);
    outline-offset: 2px;
  }

  .theme-toggle:hover .theme-toggle-sun {
    fill: var(--toggle-hover-ink);
  }

  .theme-toggle:hover .theme-toggle-moon {
    fill: var(--toggle-hover-ink);
  }

  .theme-toggle:focus-visible .theme-toggle-sun {
    fill: var(--color-accent);
  }

  .theme-toggle:focus-visible .theme-toggle-moon {
    fill: var(--color-ink);
  }

  .theme-toggle:active .theme-toggle-sun {
    fill: var(--color-accent);
  }

  .theme-toggle:active .theme-toggle-moon {
    fill: var(--color-ink);
  }
</style>
