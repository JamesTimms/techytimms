---
// The blocking script in BaseLayout applies the theme before first paint; the
// click handler is delegated from `desktop-chrome`, because this button is
// inside persisted chrome and binding per-instance would double up on it.
---

<button
  id="theme-toggle"
  type="button"
  class="panel panel-bevel px-2 py-1 font-mono text-xs uppercase tracking-widest text-ink-muted hover:text-ink"
  aria-label="Toggle colour theme"
>
  <span class="hidden dark:inline">Light</span>
  <span class="inline dark:hidden">Dark</span>
</button>
