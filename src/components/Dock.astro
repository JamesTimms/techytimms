---
import {
  BarRegion,
  DockCluster,
  DockItem,
  DockNav,
  WindowTaskButton,
  bar,
  type BarPosition,
  type BarSize,
} from '~/components/ui/Bar.tsx';
import { isCurrent, primaryNav, secondaryNav } from '~/lib/navigation';

interface Props {
  currentPath: string;
  windowTitle: string;
  position?: BarPosition;
  sticky?: boolean;
  size?: BarSize;
}

const {
  currentPath,
  windowTitle,
  position = 'bottom',
  sticky = false,
  size = 'regular',
} = Astro.props;

const hasMiddle = Astro.slots.has('middle');
---

<div
  transition:persist="dock"
  transition:name="dock"
  transition:animate="none"
  data-position={position}
  class={bar({ position, purpose: 'dock', middle: true, sticky, size })}
>
  <BarRegion position={position} region="start"><slot name="start" /></BarRegion>
  {hasMiddle && <BarRegion position={position} region="middle"><slot name="middle" /></BarRegion>}

  <DockCluster position={position}>
    <DockNav position={position}>
      {primaryNav.map((item) => <DockItem {...item} current={isCurrent(item, currentPath)} />)}
      <span class="dock-separator" aria-hidden="true"></span>
      {secondaryNav.map((item) => <DockItem {...item} current={isCurrent(item, currentPath)} />)}
    </DockNav>
    <WindowTaskButton windowTitle={windowTitle} />
  </DockCluster>

  <BarRegion position={position} region="end"><slot name="end" /></BarRegion>
</div>

<style>
  /* Square icon target; unlayered, so it beats `@layer components`. `:global` because Bar.tsx renders `.dock-cluster`. */
  :global(.dock-cluster .task-button) {
    justify-content: center;
    gap: 0;
    min-width: 2.75rem;
    height: 2.75rem;
    padding-inline: 0.625rem;
  }

  /* `border`, not `rule`: rule vanishes on the dock fill. */
  .dock-separator {
    align-self: center;
    flex: none;
    width: 1px;
    height: 1.75rem;
    margin-inline: 0.25rem;
    background-color: var(--color-border);
  }

  /* Side bars flip the tooltip so it doesn't cover neighbours; `[data-placement]` adds specificity over the tooltip default. */
  @media (min-width: 64rem) {
    .dock[data-position='left'] .dock-separator,
    .dock[data-position='right'] .dock-separator {
      width: 1.75rem;
      height: 1px;
      margin-inline: 0;
      margin-block: 0.25rem;
    }

    .dock[data-position='left'] :global(.tooltip[data-placement]) {
      --tooltip-inset: 50% auto auto calc(100% + 0.5rem);
      --tooltip-shift: translateY(-50%);
    }

    .dock[data-position='right'] :global(.tooltip[data-placement]) {
      --tooltip-inset: 50% calc(100% + 0.5rem) auto auto;
      --tooltip-shift: translateY(-50%);
    }
  }
</style>
